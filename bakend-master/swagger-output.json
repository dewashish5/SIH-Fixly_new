    "RefreshTokenInput": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "example": "64f1bc000000000000000001"
        },
        "deviceId": {
          "type": "string",
          "example": "device-uuid-12345"
        },
        "refreshToken": {
          "type": "string",
          "example": "eyJhbGciOi..."
        }
      }

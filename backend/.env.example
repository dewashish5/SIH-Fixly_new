PORT=8000
MONGO_URI=mongodb://127.0.0.1:27017/fixly
REDIS_URL=redis://127.0.0.1:6379

# Firebase Admin SDK. Prefer Application Default Credentials in production.
FCM_PROJECT_ID=your_firebase_project_id
FCM_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nreplace_me\\n-----END PRIVATE KEY-----\\n"
# Set this instead when the runtime provides Application Default Credentials.
# FCM_USE_APPLICATION_DEFAULT=true

JWT_SECRET=change_me_access_secret
REFRESH_SECRET=change_me_refresh_secret

# Razorpay — put real values in `.env` (never commit `.env`)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
